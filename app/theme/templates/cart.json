{
  "title": "Cart",
  "sections": [
    {
      "id": "cart-items",
      "type": "cart_items",
      "props": {
        "cart": "current",
        "continue_href": "/products",
        "products": {
          "from": "cart_products",
          "limit": 8
        }
      }
    },
    {
      "id": "cart-summary",
      "type": "cart_summary",
      "props": {
        "cart": "current",
        "cross_sells": {
          "from": "cart_cross_sells",
          "limit": 4
        },
        "show_note": "hide"
      }
    },
    {
      "id": "more",
      "type": "product_tiles",
      "props": {
        "heading": "Before you go",
        "products": {
          "from": "all",
          "sort": "best_selling",
          "limit": 4
        },
        "columns": "4",
        "frame": "inset",
        "heading_place": "side",
        "show_count": "hide",
        "show_sort": "hide",
        "show_filters": "hide"
      }
    },
    {
      "id": "browse",
      "type": "collection_index",
      "props": {
        "heading": "Shop by collection",
        "link_label": "All collections",
        "link_href": "/categories",
        "collections": {
          "from": "top",
          "limit": 5
        },
        "numbers": "show",
        "photos": "show"
      }
    }
  ]
}
